# Optional OpenAI-compatible endpoint serving a Gemma vision model.
GEMMA_API_URL=https://your-provider.example/v1/chat/completions
GEMMA_API_KEY=replace_with_your_secret_key
GEMMA_MODEL=gemma-3-4b-it

# Alternative: a Google AI Studio API key with a vision-capable model.
# Do not set both routes unless you specifically want the Gemma route to win.
GOOGLE_API_KEY=replace_with_your_google_api_key
GOOGLE_VISION_MODEL=gemini-2.5-flash
